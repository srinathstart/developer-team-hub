JWT_SECRET=your_jwt_secret_here
FRONTEND_URL=http://localhost:5173
PORT=3000

# Optional. If omitted, development uses the local
# developer_team_hub database on port 5432.
DATABASE_URL=postgresql://localhost:5432/developer_team_hub

# Optional. Used only when NODE_ENV=test. If omitted, tests use the
# local developer_team_hub_test database on port 5432.
TEST_DATABASE_URL=postgresql://localhost:5432/developer_team_hub_test
